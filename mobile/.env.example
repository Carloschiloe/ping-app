EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# SDK 57+: el proyecto conserva expo-router instalado (boilerplate app/
# heredado del scaffold inicial, nunca usado -- la navegación real es
# @react-navigation/* desde App.tsx). Metro rechaza esa coexistencia salvo
# que se desactive explícitamente este check oficial de Expo.
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
